<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head> 
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <h3 class="mb-5">
            <a href="/read">Read Users</a>
        </h3>
        <form action="/edit/<%= user._id %>" method="post">
            <h1 class="text-3xl tracking-tighther mb-3">Update User</h1>
            
            <input type="text" value="<%= user.name %>" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" disabled placeholder="Name">
            <input type="text" value="<%= user.email %>" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" disabled placeholder="email">
            
            <input type="text" value="<%= user.image %>" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" disabled placeholder="image url">
            <br>
            <!-- update ueser here -->
            <h3 class="mt-5 mb-5 px-5">Update Here</h3>
            <input type="text" value="<%= user.name %>" name="name" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" placeholder="Name">
            <input type="text" value="<%= user.email %>" name="email" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" placeholder="email">

            <input type="text" value="<%= user.image %>" name="image" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" placeholder="image url">
            <input type="submit" value="Update" class="px-5 py-2 bg-yellow-500 rounded-lg ml-3">

        </form>
    </div>
</body>
</html>