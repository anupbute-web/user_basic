<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head> 
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <h3 class="mb-5">
            <a href="/read">Read Users</a>
        </h3>
        <form action="/create" method="post">
            <h1 class="text-3xl tracking-tighther mb-3">Create User</h1>
            <input type="text" name="name" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" placeholder="Name">
            <input type="text" name="email" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" placeholder="email">

            <input type="text" name="image" class="px-5 py-3 border-2 border-zinc-800 outline-none rounded-lg bg-transparent" placeholder="image url">
            <input type="submit" class="px-5 py-2 bg-blue-500 rounded-lg ml-3">

        </form>
    </div>
</body>
</html>