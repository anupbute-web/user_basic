<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <h3 class="mb-5">
            <a href="/">Back to Home</a>
        </h3>
        <form action="">
            <h1 class="text-3xl tracking-tighther mb-3">All Users</h1>
            <div class="users flex gap-3 flex-wrap">
                <% users.forEach((e)=>{ %>  
                    <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                        <div class="w-full h-52 rounded-lg bg-red-500"><img src= "<%= e.image_url %>" alt="" srcset=""></div>
                        <h3 class="text-xl mt-3 tracking-tighter"><%= e.name %></h3>
                        <h5 class="text-zinc-500"><%= e.email %></h5>
                        <div class="flex gap-3 mt-10">
                            <a href="" class="text-zinc-200">Edit user</a>
                            <a href="" class="text-red-500">Delete user</a>
    
                        </div>
                    </div>    
                <% }) %>         
            </div>

        </form>
    </div>
</body>
</html>